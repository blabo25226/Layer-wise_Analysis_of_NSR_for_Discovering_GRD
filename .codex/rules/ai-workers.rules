# Authorized delegated worker invocations may run without an extra Codex approval.
# Existing .ai/workers wrappers remain the single entrypoint.

prefix_rule(
    pattern = [".ai/workers/claude.sh"],
    decision = "allow",
    justification = "Claude worker is an authorized autonomous research worker",
    match = [
        ".ai/workers/claude.sh Review the design",
        ".ai/workers/claude.sh --write Implement the frozen plan",
        ".ai/workers/claude.sh --json Return a status summary",
    ],
)

prefix_rule(
    pattern = [".ai/workers/cursor.sh"],
    decision = "allow",
    justification = "Cursor worker is an authorized autonomous repo operator",
    match = [
        ".ai/workers/cursor.sh Review the implementation",
        ".ai/workers/cursor.sh --write Implement and test the task",
        ".ai/workers/cursor.sh --json Return a status summary",
    ],
)

prefix_rule(
    pattern = [".ai/workers/gemini.sh"],
    decision = "allow",
    justification = "Gemini worker is an authorized autonomous scout and bulk worker",
    match = [
        ".ai/workers/gemini.sh Summarize the artifacts",
        ".ai/workers/gemini.sh --write Build the artifact index",
        ".ai/workers/gemini.sh --json Return a status summary",
    ],
)

prefix_rule(
    pattern = [".ai/workers/claude.sh", "--write"],
    decision = "allow",
    justification = "Write-mode delegation is pre-authorized for isolated research tasks",
    match = [".ai/workers/claude.sh --write Implement the task"],
)

prefix_rule(
    pattern = [".ai/workers/cursor.sh", "--write"],
    decision = "allow",
    justification = "Write-mode delegation is pre-authorized for isolated research tasks",
    match = [".ai/workers/cursor.sh --write Implement the task"],
)

prefix_rule(
    pattern = [".ai/workers/gemini.sh", "--write"],
    decision = "allow",
    justification = "Write-mode delegation is pre-authorized for isolated research tasks",
    match = [".ai/workers/gemini.sh --write Produce the artifact"],
)
