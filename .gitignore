# docs/: track runbooks and plans; keep local literature untracked
/docs/**
!/docs/README.md
!/docs/runbooks/
!/docs/runbooks/**
!/docs/plans/
!/docs/plans/**

/weights/
/data/
**/weights/

# Python caches, test output, and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
build/
dist/
site/

# Local Python environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Notebook, editor, and operating-system artifacts
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*~
*.bak
*.tmp

# Training logs and large model artifacts
*.log
wandb/
lightning_logs/
*.ckpt
*.pt
*.pth
*.onnx
*.tar.gz

# Local experiment artifacts
results/runs/
results/archives/
results/GPU_RUN1_drive/
# Smoke runs are throwaway; keeping them untracked would block the next campaign,
# which requires a completely clean working tree.
graphs/*_smoke/
graphs/gpu_smoke_*/
# Phase 9 keeps every physical failure event locally.  The export is tens of
# megabytes and reproducible from the signed, gitignored run shards; commit the
# compact failure funnel and provenance map instead.
graphs/gpu_run5_*/tables/phase9_failure_events.csv
results/published/*_smoke/
results/synthetic/_test_tmp/
.claude/*
!.claude/settings.json

# Official ND2 analysis notebooks with embedded outputs. Not imported at runtime.
# Local copies may remain on disk; the survey tree is GitHubSourceCode/ND2/scripts/.
third_party/nd2/scripts/*.ipynb
